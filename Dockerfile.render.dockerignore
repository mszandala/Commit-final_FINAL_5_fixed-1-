# Repozytorium
.git
.gitattributes
graphify-out

# Sekrety i stan lokalny: nigdy do obrazu (klucz podaje compose przez zmienne środowiskowe)
.env
**/.env
backend/spending.db
backend/audit/*.jsonl
backend/audit/*.db
backend/audit/*.db-*
policy/*.overrides.json


# Cache i artefakty
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.venv
**/venv
**/node_modules
frontend/dist

# Dokumenty i skrypty, których obraz nie potrzebuje
*.md
!DOCKER.md
