# Obraz do wdrożenia na Render: gotowy obraz backendu plus dane z backend/data (w zwykłym obrazie ich nie ma,
# bo compose montuje je z hosta). Dane pochodzą z Git LFS, więc buduj lokalnie po `git lfs checkout`.
#
#   docker compose build backend
#   docker build -f Dockerfile.render -t ghcr.io/<użytkownik>/ai-control-layer:render .
#
# Reguły .dockerignore są w Dockerfile.render.dockerignore (to samo co .dockerignore, ale z danymi).
ARG BASE=ai-control-layer-backend:local
FROM ${BASE}
COPY --chown=10001:10001 backend/data/ /repo/backend/data/
