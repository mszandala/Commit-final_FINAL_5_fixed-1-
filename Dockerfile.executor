# Python code executor (run_python tool): isolated container without network or data, with resource limits.
# Contains only what is needed for code inspection and execution: no extra libraries, models, or data.
FROM python:3.12-slim


ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

COPY backend/executor.py /app/executor.py
COPY backend/security/code_guard.py /app/security/code_guard.py
COPY backend/security/common/verdicts.py /app/security/common/verdicts.py

RUN useradd --system --uid 10001 --home-dir /nonexistent --no-create-home executor \
 && install -d -o 10001 -g 10001 -m 0700 /run/executor
USER 10001:10001

CMD ["python", "-m", "executor", "--socket", "/run/executor/executor.sock"]
