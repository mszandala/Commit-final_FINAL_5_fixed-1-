# Provider LLM: "openrouter" lub "ollama"
LLM_PROVIDER=openrouter

# Konfiguracja OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Konfiguracja Ollama
OLLAMA_MODEL=gemma4:12b

# Konfiguracja detektora PII (GLiNER)
PII_MODEL=urchade/gliner_small-v2.1
PII_THRESHOLD=0.35

# Strefa bezpieczeństwa (strażnicy, sędziowie) - widzi dane surowe; docelowo model lokalny.
# Puste = ten sam provider i model co chatbot.
SECURITY_PROVIDER=
SECURITY_MODEL=

# Maskowanie danych wrażliwych w strefie chatbota (prompt, historia, wyniki narzędzi)
MASKING_ENABLED=true
# Sędzia LLM dla typów oznaczonych "judge" w CHATBOT_PII_POLICY (false = zawsze maskuj)
PII_JUDGE_ENABLED=true
# Klucz HMAC do pseudonimizacji identyfikatorów. Pusty = losowy przy każdym starcie,
# czyli pseudonimy zmieniają się między uruchomieniami. Ustaw stały, losowy ciąg.
PSEUDONYM_KEY=

# Tryb strażnika promptu: warn (ostrzega i przepuszcza) albo block (zatrzymuje zapytanie)
PROMPT_GUARD_MODE=block
# Klasyfikator intencji (LLM): czy zapytanie mieści się w pracy roli. false = decydują słowa kluczowe strażnika
INTENT_CLASSIFIER_ENABLED=true

# Moduł regulaminów firmowych w przebiegu tury (security/company_policies)
COMPANY_POLICIES_ENABLED=true
# Klasyfikator semantyczny modułu: security = strefa bezpieczeństwa, policy = provider z rules.txt (lokalna Ollama)
COMPANY_POLICIES_CLASSIFIER=security

# Wykrywanie odmowy chatbota: słowa kluczowe plus lokalny model embeddingów (false = same słowa kluczowe)
REFUSAL_DETECTION_ENABLED=true
REFUSAL_EMBEDDINGS_ENABLED=true
REFUSAL_THRESHOLD=0.5
# Sędzia LLM potwierdza odmowę; kandydatem jest odpowiedź od tego (niższego) progu podobieństwa
REFUSAL_JUDGE_ENABLED=true
REFUSAL_TRIGGER_THRESHOLD=0.35

# Limity: długość promptu (znaki), tokeny i koszt jednej tury w strefie chatbota, długość wyniku narzędzia
MAX_PROMPT_CHARS=4000
MAX_TURN_TOKENS=40000
MAX_TURN_COST=0.05
MAX_TOOL_RESULT_CHARS=24000

# Serwer API (python main.py)
API_HOST=127.0.0.1
API_PORT=8000
# Adresy frontendu, które mogą wołać API z przeglądarki (po przecinku)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
